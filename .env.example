# Copy to .env and fill in. Never commit .env.

# SEC asks automated clients to identify themselves: your name and contact email.
SEC_USER_AGENT="Your Name your.email@example.com"

# Anthropic API key for the extraction step.
ANTHROPIC_API_KEY=
# Optional: model override (default claude-sonnet-5-5).
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: earliest filing date to scan (default 2024-01-01).
# TRACKER_START_DATE=2024-01-01

# Optional: earnings call transcripts from Equibles (free key at equibles.com/dashboard/apikeys)
TRANSCRIPT_API_KEY=
